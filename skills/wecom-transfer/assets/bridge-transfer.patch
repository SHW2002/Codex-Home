--- /dev/null
+++ b/src/desktop-transfer/status.ts
@@ -0,0 +1,33 @@
+import { readFile, readdir } from 'node:fs/promises';
+import { join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import type { Binding } from './store.js';
+
+export interface DeliveryStatus { status: string; submittedAt?: string; updatedAt?: string }
+async function json(path: string): Promise<any> {
+  try { return JSON.parse(await readFile(path, 'utf8')); }
+  catch (error) { if ((error as NodeJS.ErrnoException).code === 'ENOENT') return undefined; throw error; }
+}
+export async function readLatestDelivery(binding: Binding, botKey: string, actor: string,
+  root = fileURLToPath(new URL('../../../.runtime/', import.meta.url))): Promise<DeliveryStatus> {
+  const files = await readdir(join(root, 'desktop-actions')).catch((error: NodeJS.ErrnoException) => {
+    if (error.code === 'ENOENT') return [] as string[];
+    throw error;
+  });
+  let latest: { file: string; ledger: any } | undefined;
+  for (const file of files) {
+    if (!/^[a-f0-9]{64}\.json$/.test(file)) continue;
+    const ledger = await json(join(root, 'desktop-actions', file));
+    if (!ledger || ledger.threadId !== binding.threadId || typeof ledger.at !== 'string' ||
+        ledger.at < binding.boundAt || !/^[a-f0-9]{64}$/.test(ledger.notificationKey ?? '')) continue;
+    const route = await json(join(root, 'desktop-notifications', ledger.notificationKey + '.json'));
+    if (route?.botKey !== botKey || route.actor !== actor || route.group || route.target !== actor) continue;
+    if (!latest || ledger.at > latest.ledger.at) latest = { file, ledger };
+  }
+  if (!latest) return { status: 'no_message' };
+  const receipt = await json(join(root, 'desktop-notifications', latest.file + '.receipt'));
+  const known = ['accepted', 'sending', 'unknown', 'ready', 'delivered'];
+  const status = receipt?.status ?? latest.ledger.status;
+  return { status: known.includes(status) ? status : 'unknown', submittedAt: latest.ledger.at,
+    ...(typeof receipt?.updatedAt === 'string' ? { updatedAt: receipt.updatedAt } : {}) };
+}
