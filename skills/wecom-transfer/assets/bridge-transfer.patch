diff --git a/src/desktop-transfer/controller.ts b/src/desktop-transfer/controller.ts
new file mode 100644
index 0000000..9909c1c
--- /dev/null
+++ b/src/desktop-transfer/controller.ts
@@ -0,0 +1,81 @@
+import { BindingStore, isThreadId, type Binding } from './store.js';
+import { parseDesktopRequest } from '../desktop-routing/request.js';
+import type { DeliveryStatus } from './status.js';
+
+interface Options {
+  botKey: string;
+  owners: readonly string[];
+  enabled: () => boolean;
+  connected: () => boolean;
+  lookup: (threadId: string) => Promise<{ id: string; title: string }>;
+  announce: (actor: string, text: string) => Promise<unknown>;
+  delivery?: (binding: Binding, actor: string) => Promise<DeliveryStatus>;
+  store?: BindingStore;
+}
+export class TransferError extends Error {
+  constructor(readonly status: number, readonly code: string) { super(code); }
+}
+export type TransferResolution = { reply: string } | { binding: Binding } | undefined;
+
+export class DesktopTransfer {
+  private readonly store: BindingStore;
+  private busy = false;
+  constructor(private readonly options: Options) {
+    this.store = options.store ?? new BindingStore(options.botKey);
+  }
+
+  private owner(): string {
+    if (!this.options.enabled()) throw new TransferError(409, 'desktop_transfer_disabled');
+    if (this.options.owners.length !== 1) throw new TransferError(409, 'single_authorized_owner_required');
+    return this.options.owners[0]!;
+  }
+
+  async current() {
+    const owner = this.owner();
+    const binding = await this.store.get(owner);
+    return binding ? { status: 'bound', binding,
+      ...(this.options.delivery ? { delivery: await this.options.delivery(binding, owner) } : {}) } : { status: 'unbound' };
+  }
+
+  async activate(threadId: unknown) {
+    const owner = this.owner();
+    if (!isThreadId(threadId)) throw new TransferError(400, 'invalid_thread_id');
+    if (!this.options.connected()) throw new TransferError(503, 'wecom_disconnected');
+    if (this.busy) throw new TransferError(409, 'transfer_busy');
+    this.busy = true;
+    try {
+      const info = await this.options.lookup(threadId);
+      if (info.id !== threadId || !info.title?.trim()) throw new TransferError(404, 'thread_not_found');
+      const binding = { threadId, title: info.title.trim(), boundAt: new Date().toISOString() };
+      await this.store.set(owner, binding);
+      let notification = 'sent';
+      try {
+        await this.options.announce(owner,
+          `已接续到“${binding.title}”喵\n直接发送文字或语音即可继续这个原聊天，回复完成后会回到这里喵\n电脑端当前一轮结束后才会处理新消息喵\n查看：/desktop status；解除：/desktop off 喵`);
+      } catch { notification = 'unknown'; }
+      return { status: 'bound', binding, notification, delivery: 'awaiting_wecom_message' };
+    } finally { this.busy = false; }
+  }
+
+  async resolve(actor: string, text: string, hasAttachments: boolean): Promise<TransferResolution> {
+    if (!this.options.owners.includes(actor)) return undefined;
+    const command = text.trim().toLowerCase();
+    if (/^\/desktop(?:\s|$)/.test(command)) {
+      if (command === '/desktop off') {
+        if (this.busy) return { reply: '正在切换聊天，请稍后再解除喵' };
+        await this.store.clear(actor);
+        return { reply: '已解除桌面聊天接续，后续消息恢复企微独立对话喵' };
+      }
+      const binding = await this.store.get(actor);
+      return { reply: (binding ? `当前接续“${binding.title}”喵\n` : '当前没有接续桌面聊天喵\n') +
+        '在目标 Codex 聊天调用 $wecom-transfer 可切换；/desktop off 可解除喵' };
+    }
+    const binding = await this.store.get(actor);
+    if (!binding) return undefined;
+    if (!this.options.enabled()) return { reply: '桌面聊天接续已停用，尚未投递这条消息喵' };
+    if (hasAttachments) return { reply: '当前接续支持文字和语音，附件尚未投递，请在电脑端添加，或先 /desktop off 喵' };
+    // Explicitly named requests retain the existing one-message routing behavior.
+    if (parseDesktopRequest(text)) return undefined;
+    return { binding };
+  }
+}
