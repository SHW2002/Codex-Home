+++ b/src/desktop-transfer/store.ts
@@ -0,0 +1,42 @@
+import { createHash, randomUUID } from 'node:crypto';
+import { mkdir, readFile, rename, rm, writeFile } from 'node:fs/promises';
+import { join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+export interface Binding { threadId: string; title: string; boundAt: string }
+export const isThreadId = (value: unknown): value is string => typeof value === 'string' &&
+  /^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$/i.test(value);
+
+export class BindingStore {
+  constructor(private readonly botKey: string,
+    private readonly root = fileURLToPath(new URL('../../../.runtime/desktop-transfer/', import.meta.url))) {}
+
+  private path(actor: string): string {
+    return join(this.root, createHash('sha256').update(JSON.stringify([this.botKey, actor])).digest('hex') + '.json');
+  }
+
+  async get(actor: string): Promise<Binding | undefined> {
+    let value: Binding;
+    try { value = JSON.parse(await readFile(this.path(actor), 'utf8')); }
+    catch (error) {
+      if ((error as NodeJS.ErrnoException).code === 'ENOENT') return undefined;
+      throw new Error('binding_store_unavailable');
+    }
+    if (!isThreadId(value?.threadId) || typeof value.title !== 'string' || typeof value.boundAt !== 'string') {
+      throw new Error('binding_store_invalid');
+    }
+    return value;
+  }
+
+  async set(actor: string, binding: Binding): Promise<void> {
+    await mkdir(this.root, { recursive: true });
+    const path = this.path(actor);
+    const temp = path + '.' + randomUUID() + '.tmp';
+    try {
+      await writeFile(temp, JSON.stringify(binding), { mode: 0o600 });
+      await rename(temp, path);
+    } finally { await rm(temp, { force: true }); }
+  }
+
+  async clear(actor: string): Promise<void> { await rm(this.path(actor), { force: true }); }
+}
