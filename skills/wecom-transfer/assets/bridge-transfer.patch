+++ b/src/desktop-transfer/relay.ts
@@ -0,0 +1,42 @@
+import { generateReqId, type BaseMessage, type WSClient, type WsFrame } from '@wecom/aibot-node-sdk';
+import type { DesktopNotifications } from '../desktop-notifications.js';
+import { submitThreadRequest, type DesktopTool } from '../desktop-routing/request.js';
+import { runDesktopTool } from '../desktop-routing/tool.js';
+import { WeComStreamResponder } from '../wecom-stream.js';
+import type { Binding } from './store.js';
+
+interface Options {
+  botKey: string;
+  allowed: boolean;
+  notifications: DesktopNotifications;
+  flushMs: number;
+  timeoutMs: number;
+  run?: DesktopTool;
+}
+export async function relayDesktopMessage<T extends BaseMessage>(client: WSClient, frame: WsFrame<T>,
+  binding: Binding, prompt: string, options: Options): Promise<void> {
+  const body = frame.body;
+  if (!body) return;
+  const target = body.chattype === 'group' ? body.chatid : body.from.userid;
+  const responder = new WeComStreamResponder(client, frame, generateReqId('stream'), {
+    flushMs: options.flushMs, timeoutMs: options.timeoutMs, ...(target ? { proactiveTarget: target } : {}),
+  });
+  const requestId = options.botKey + ':' + body.msgid;
+  try {
+    if (!options.allowed || !target || body.chattype === 'group') {
+      await responder.open('当前会话未获桌面聊天接续授权，尚未投递喵');
+      await responder.update({ kind: 'replace', text: '当前会话未获桌面聊天接续授权，尚未投递喵' });
+    } else {
+      await options.notifications.register(requestId, {
+        botKey: options.botKey, target, actor: body.from.userid, group: false,
+      });
+      await responder.open(`正在投递到“${binding.title}”喵`);
+      const run = options.run ?? (args => runDesktopTool(args, requestId));
+      await responder.update({ kind: 'replace', text:
+        await submitThreadRequest(binding.threadId, binding.title, prompt, run) });
+    }
+    await responder.complete();
+  } catch {
+    await responder.fail('投递未能确认，请先查看原聊天，避免重复发送喵');
+  } finally { options.notifications.release(requestId); }
+}
