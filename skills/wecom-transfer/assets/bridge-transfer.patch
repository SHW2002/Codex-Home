+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createServer, request as httpRequest } from 'node:http';
+import { handleTransferRequest } from '../dist/src/desktop-transfer/http.js';
+import { TransferError } from '../dist/src/desktop-transfer/controller.js';
+
+const id = '11111111-1111-1111-1111-111111111111';
+async function fixture(t, overrides = {}) {
+  const calls = [];
+  const desktopTransfer = {
+    current: async () => ({ status: 'unbound' }),
+    activate: async threadId => { calls.push(threadId); return { status: 'bound' }; }, ...overrides,
+  };
+  const server = createServer((req, res) => void handleTransferRequest(req, res, [{ desktopTransfer }]));
+  await new Promise(resolve => server.listen(0, '127.0.0.1', resolve));
+  t.after(() => { server.closeAllConnections(); return new Promise(resolve => server.close(resolve)); });
+  const url = `http://127.0.0.1:${server.address().port}/desktop/transfer`;
+  const headers = { 'X-Codex-Transfer': '1', 'Content-Type': 'application/json' };
+  return { url, headers, calls };
+}
+
+test('local JSON client can bind and query without filesystem credentials', async t => {
+  const f = await fixture(t);
+  const response = await fetch(f.url, { method: 'POST', headers: f.headers, body: JSON.stringify({ threadId: id }) });
+  assert.equal(response.status, 200); assert.equal((await response.json()).status, 'bound');
+  assert.deepEqual(f.calls, [id]);
+  assert.equal((await (await fetch(f.url, { headers: f.headers })).json()).status, 'unbound');
+});
+
+test('browser, missing client marker, rebinding host and preflight requests cannot mutate', async t => {
+  const f = await fixture(t);
+  for (const headers of [{}, { ...f.headers, Origin: 'https://example.com' },
+    { ...f.headers, 'Sec-Fetch-Site': 'same-origin' }]) {
+    const res = await fetch(f.url, { method: 'POST', headers, body: JSON.stringify({ threadId: id }) });
+    assert.equal(res.status, 403);
+  }
+  const status = await new Promise((resolve, reject) => {
+    const req = httpRequest(f.url, { method: 'POST', headers: { ...f.headers, Host: 'evil.example' } }, res => {
+      res.resume(); resolve(res.statusCode);
+    });
+    req.on('error', reject); req.end(JSON.stringify({ threadId: id }));
+  });
+  assert.equal(status, 403);
+  assert.equal((await fetch(f.url, { method: 'OPTIONS', headers: f.headers })).status, 405);
+  assert.deepEqual(f.calls, []);
+});
+
+test('API accepts only a bounded threadId payload, no command or arbitrary prompt', async t => {
+  const f = await fixture(t);
+  for (const body of ['{', 'null', '1', '[]', '{}', JSON.stringify({ threadId: id, prompt: 'execute' })]) {
+    assert.equal((await fetch(f.url, { method: 'POST', headers: f.headers, body })).status, 400);
+  }
+  assert.equal((await fetch(f.url, { method: 'POST', headers: f.headers, body: 'x'.repeat(4097) })).status, 413);
+  assert.equal((await fetch(f.url, { method: 'POST', headers: { 'X-Codex-Transfer': '1' }, body: '{}' })).status, 415);
+  assert.deepEqual(f.calls, []);
+});
+
+test('diagnostics expose stable error codes without underlying process details', async t => {
+  const f = await fixture(t, { activate: async () => { throw new Error('private process detail'); } });
+  const res = await fetch(f.url, { method: 'POST', headers: f.headers, body: JSON.stringify({ threadId: id }) });
+  assert.equal(res.status, 503); assert.equal((await res.json()).error, 'transfer_unavailable');
+  const g = await fixture(t, { activate: async () => { throw new TransferError(503, 'wecom_disconnected'); } });
+  assert.equal((await (await fetch(g.url, { method: 'POST', headers: g.headers, body: '{}' })).json()).error, 'thread_id_only');
+});
diff --git a/test/desktop-transfer-relay.test.mjs b/test/desktop-transfer-relay.test.mjs
new file mode 100644
index 0000000..6f9f5d5
--- /dev/null
+++ b/test/desktop-transfer-relay.test.mjs
@@ -0,0 +1,54 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { relayDesktopMessage } from '../dist/src/desktop-transfer/relay.js';
+
+const id = '11111111-1111-1111-1111-111111111111';
+const binding = { threadId: id, title: '原聊天', boundAt: new Date().toISOString() };
+const frame = { headers: { req_id: 'test-frame' }, body: {
+  msgid: 'unit-test-only', chattype: 'single', from: { userid: 'owner' },
+} };
+function fixture() {
+  const registrations = [], released = [], calls = [], replies = [];
+  const client = {
+    replyStream: async (_frame, _key, text, final) => replies.push({ text, final }),
+    replyStreamNonBlocking: async () => {}, sendMessage: async () => {},
+  };
+  const options = { botKey: 'bot', allowed: true, flushMs: 10000, timeoutMs: 10000,
+    notifications: {
+      register: async (...args) => registrations.push(args),
+      release: requestId => released.push(requestId),
+    },
+    run: async args => { calls.push(args); return { status: args[0] === 'send' ? 'accepted' : 'background_tracking' }; },
+  };
+  return { client, options, calls, replies, registrations, released };
+}
+
+test('relay preserves real incoming msgid and original sender for later final-answer return', async () => {
+  const f = fixture();
+  await relayDesktopMessage(f.client, frame, binding, '继续', f.options);
+  assert.deepEqual(f.registrations, [['bot:unit-test-only', {
+    botKey: 'bot', target: 'owner', actor: 'owner', group: false,
+  }]]);
+  assert.deepEqual(f.calls.map(c => c[0]), ['send', 'wait']);
+  assert.equal(f.calls[0][1], id);
+  assert.deepEqual(f.released, ['bot:unit-test-only']);
+  assert.match(f.replies.at(-1).text, /已提交/); assert.equal(f.replies.at(-1).final, true);
+});
+
+test('relay denies unauthorized and group messages without registering or sending', async () => {
+  for (const group of [false, true]) {
+    const f = fixture();
+    await relayDesktopMessage(f.client, group ? { ...frame, body: { ...frame.body, chattype: 'group', chatid: 'group' } } : frame,
+      binding, '继续', { ...f.options, allowed: group });
+    assert.deepEqual(f.calls, []); assert.deepEqual(f.registrations, []);
+    assert.match(f.replies.at(-1).text, /未获/);
+  }
+});
+
+test('uncertain send is not retried and watcher registration is released', async () => {
+  const f = fixture();
+  f.options.run = async args => { f.calls.push(args); throw new Error('lost connection'); };
+  await relayDesktopMessage(f.client, frame, binding, '确认', f.options);
+  assert.equal(f.calls.length, 1); assert.deepEqual(f.released, ['bot:unit-test-only']);
+  assert.match(f.replies.at(-1).text, /避免重复/);
+});
diff --git a/test/desktop-transfer-status.test.mjs b/test/desktop-transfer-status.test.mjs
new file mode 100644
index 0000000..ca5b50d
--- /dev/null
+++ b/test/desktop-transfer-status.test.mjs
@@ -0,0 +1,34 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtemp, mkdir, writeFile, rm } from 'node:fs/promises';
+import { join } from 'node:path';
+import { tmpdir } from 'node:os';
+import { readLatestDelivery } from '../dist/src/desktop-transfer/status.js';
+
+test('status exposes only post-binding matching-actor delivery metadata, not messages or credentials', async t => {
+  const root = await mkdtemp(join(tmpdir(), 'wecom-delivery-'));
+  t.after(() => rm(root, { recursive: true, force: true }));
+  const binding = { threadId: 'thread', title: 'chat', boundAt: '2026-10-20T01:00:00.000Z' };
+  assert.deepEqual(await readLatestDelivery(binding, 'bot', 'owner', root), { status: 'no_message' });
+  await mkdir(join(root, 'desktop-actions')); await mkdir(join(root, 'desktop-notifications'));
+  async function seed(key, at, route, status) {
+    const file = key.repeat(64) + '.json';
+    await writeFile(join(root, 'desktop-actions', file), JSON.stringify({ threadId: 'thread', at,
+      status: 'accepted', notificationKey: key.repeat(64), prompt: 'private content' }));
+    await writeFile(join(root, 'desktop-notifications', key.repeat(64) + '.json'), JSON.stringify(route));
+    if (status) await writeFile(join(root, 'desktop-notifications', file + '.receipt'),
+      JSON.stringify({ status, updatedAt: at, parts: ['private reply'] }));
+  }
+  const route = { botKey: 'bot', target: 'owner', actor: 'owner', group: false };
+  await seed('a', '2026-10-20T00:00:00.000Z', route, 'delivered');
+  await seed('b', '2026-10-20T02:00:00.000Z', { ...route, actor: 'other' }, 'delivered');
+  assert.deepEqual(await readLatestDelivery(binding, 'bot', 'owner', root), { status: 'no_message' });
+  await seed('c', '2026-10-20T03:00:00.000Z', route);
+  assert.deepEqual(await readLatestDelivery(binding, 'bot', 'owner', root), {
+    status: 'accepted', submittedAt: '2026-10-20T03:00:00.000Z',
+  });
+  await seed('c', '2026-10-20T03:00:00.000Z', route, 'delivered');
+  assert.deepEqual(await readLatestDelivery(binding, 'bot', 'owner', root), {
+    status: 'delivered', submittedAt: '2026-10-20T03:00:00.000Z', updatedAt: '2026-10-20T03:00:00.000Z',
+  });
+});
diff --git a/test/desktop-transfer.test.mjs b/test/desktop-transfer.test.mjs
new file mode 100644
index 0000000..876ee7e
--- /dev/null
+++ b/test/desktop-transfer.test.mjs
@@ -0,0 +1,90 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtemp, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { DesktopTransfer } from '../dist/src/desktop-transfer/controller.js';
+import { BindingStore } from '../dist/src/desktop-transfer/store.js';
+import { submitThreadRequest } from '../dist/src/desktop-routing/request.js';
+
+const id = '11111111-1111-1111-1111-111111111111';
+const other = '22222222-2222-2222-2222-222222222222';
+async function fixture(t, overrides = {}) {
+  const root = await mkdtemp(join(tmpdir(), 'wecom-transfer-'));
+  t.after(() => rm(root, { recursive: true, force: true }));
+  const notices = [];
+  const store = new BindingStore('bot', root);
+  const options = { botKey: 'bot', store, owners: ['owner'], enabled: () => true,
+    connected: () => true, lookup: async threadId => ({ id: threadId, title: '同名聊天' }),
+    announce: async (actor, text) => notices.push({ actor, text }), ...overrides };
+  return { options, notices, root, controller: new DesktopTransfer(options) };
+}
+
+test('one activation persists the UUID target and plain follow-ups survive service restart', async t => {
+  const f = await fixture(t);
+  const result = await f.controller.activate(id);
+  assert.equal(result.status, 'bound'); assert.equal(result.notification, 'sent');
+  assert.equal(result.delivery, 'awaiting_wecom_message');
+  assert.equal(f.notices.length, 1); assert.equal(f.notices[0].actor, 'owner');
+  const restarted = new DesktopTransfer({ ...f.options, store: new BindingStore('bot', f.root) });
+  assert.equal((await restarted.resolve('owner', '继续处理', false)).binding.threadId, id);
+  await restarted.activate(other);
+  assert.equal((await restarted.resolve('owner', '继续', false)).binding.threadId, other);
+  assert.match((await restarted.resolve('owner', '/desktop off', false)).reply, /已解除/);
+  assert.equal(await restarted.resolve('owner', '新的普通对话', false), undefined);
+});
+
+test('unauthorized actors and attachments cannot reach the bound desktop', async t => {
+  const f = await fixture(t);
+  await f.controller.activate(id);
+  assert.equal(await f.controller.resolve('stranger', '继续', false), undefined);
+  assert.match((await f.controller.resolve('owner', '[图片]', true)).reply, /附件尚未投递/);
+  assert.equal(await f.controller.resolve('owner', '在“另一个”这个已有 Codex 聊天中继续：确认', false), undefined);
+  const otherBot = new DesktopTransfer({ ...f.options, store: new BindingStore('other-bot', f.root) });
+  assert.equal(await otherBot.resolve('owner', '继续', false), undefined);
+});
+
+test('disconnected, ambiguous-owner and invalid target failures leave prior binding unchanged', async t => {
+  const f = await fixture(t);
+  await f.controller.activate(id);
+  await assert.rejects(f.controller.activate('../secret'), /invalid_thread_id/);
+  await assert.rejects(new DesktopTransfer({ ...f.options, connected: () => false }).activate(other), /wecom_disconnected/);
+  await assert.rejects(new DesktopTransfer({ ...f.options, owners: ['a', 'b'] }).activate(other), /single_authorized_owner/);
+  await assert.rejects(new DesktopTransfer({ ...f.options, enabled: () => false }).activate(other), /disabled/);
+  await assert.rejects(new DesktopTransfer({ ...f.options, lookup: async () => ({ id: other, title: 'wrong' }) }).activate(id), /thread_not_found/);
+  assert.equal((await f.controller.current()).binding.threadId, id);
+});
+
+test('uncertain activation announcement keeps binding and is never automatically resent', async t => {
+  let attempts = 0;
+  const f = await fixture(t, { announce: async () => { attempts++; throw new Error('lost ack'); } });
+  assert.equal((await f.controller.activate(id)).notification, 'unknown');
+  assert.equal((await f.controller.current()).status, 'bound');
+  await f.controller.resolve('owner', '继续', false);
+  assert.equal(attempts, 1);
+});
+
+test('concurrent activation is rejected rather than racing bindings', async t => {
+  let release;
+  const gate = new Promise(resolve => { release = resolve; });
+  const f = await fixture(t, { lookup: async threadId => { await gate; return { id: threadId, title: 'chat' }; } });
+  const active = f.controller.activate(id);
+  await assert.rejects(f.controller.activate(other), /transfer_busy/);
+  assert.match((await f.controller.resolve('owner', '/desktop off', false)).reply, /正在切换/);
+  release(); await active;
+  assert.equal((await f.controller.current()).binding.threadId, id);
+});
+
+test('bound submissions use the UUID once and never retry an unknown result', async () => {
+  const calls = [];
+  const reply = await submitThreadRequest(id, '同名聊天', '你好😀', async args => {
+    calls.push(args); return { status: args[0] === 'send' ? 'accepted' : 'background_tracking' };
+  });
+  assert.match(reply, /已提交/);
+  assert.deepEqual(calls.map(c => c[0]), ['send', 'wait']);
+  assert.equal(calls[0][1], id);
+  assert.equal(Buffer.from(calls[0][2], 'base64').toString('utf8'), '你好😀');
+  let count = 0;
+  assert.match(await submitThreadRequest(id, 'chat', '确认', async () => { count++; return { status: 'unknown' }; }), /不要重复/);
+  assert.equal(count, 1);
+});
