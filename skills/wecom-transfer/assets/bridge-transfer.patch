new file mode 100644
index 0000000..6895f4a
--- /dev/null
+++ b/src/desktop-transfer/http.ts
@@ -0,0 +1,47 @@
+import type { IncomingMessage, ServerResponse } from 'node:http';
+import { DesktopTransfer, TransferError } from './controller.js';
+
+interface Service { readonly desktopTransfer: DesktopTransfer }
+function reply(response: ServerResponse, status: number, body: unknown): void {
+  response.writeHead(status, { 'Content-Type': 'application/json; charset=utf-8', 'Cache-Control': 'no-store' });
+  response.end(JSON.stringify(body));
+}
+
+export async function handleTransferRequest(request: IncomingMessage, response: ServerResponse,
+  services: readonly Service[]): Promise<void> {
+  // Loopback alone is insufficient: reject browser requests and DNS rebinding.
+  if (request.socket.remoteAddress !== '127.0.0.1' ||
+      request.headers.host !== `127.0.0.1:${request.socket.localPort}` ||
+      request.headers.origin !== undefined || request.headers['sec-fetch-site'] !== undefined ||
+      request.headers['x-codex-transfer'] !== '1') {
+    reply(response, 403, { error: 'local_client_required' }); return;
+  }
+  if (services.length !== 1) {
+    reply(response, 409, { error: 'single_bot_required' }); return;
+  }
+  const transfer = services[0]!.desktopTransfer;
+  try {
+    if (request.method === 'GET') { reply(response, 200, await transfer.current()); return; }
+    if (request.method !== 'POST') { reply(response, 405, { error: 'method_not_allowed' }); return; }
+    if (!/^application\/json(?:\s*;|$)/i.test(request.headers['content-type'] ?? '')) {
+      reply(response, 415, { error: 'json_required' }); return;
+    }
+    const chunks: Buffer[] = [];
+    let size = 0;
+    for await (const chunk of request) {
+      size += chunk.length;
+      if (size > 4096) { reply(response, 413, { error: 'body_too_large' }); return; }
+      chunks.push(Buffer.from(chunk));
+    }
+    let body: Record<string, unknown>;
+    try { body = JSON.parse(Buffer.concat(chunks).toString('utf8')); }
+    catch { throw new TransferError(400, 'invalid_json'); }
+    if (!body || typeof body !== 'object' || Array.isArray(body) || Object.keys(body).length !== 1 || !('threadId' in body)) {
+      throw new TransferError(400, 'thread_id_only');
+    }
+    reply(response, 200, await transfer.activate(body.threadId));
+  } catch (error) {
+    if (error instanceof TransferError) reply(response, error.status, { error: error.code });
+    else reply(response, 503, { error: 'transfer_unavailable', action: 'check_service_diagnostics' });
+  }
+}
