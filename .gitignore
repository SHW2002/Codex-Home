# Sync reusable prompt assets; keep local credentials and runtime state outside Git.
/*
!/.gitignore
!/.gitattributes
!/.git_contribute.bat
!/AGENTS.md
!/README.md
!/README_CN.md
!/skills/

# Built-in skills are installed and updated by Codex.
/skills/.system/

# Do not sync secrets or generated files inside custom skills either.
**/.env
**/.env.*
!**/.env.example
**/auth.json*
**/config.toml.bak*
**/*私密*
**/*.private.*
**/node_modules/
**/__pycache__/
**/*.pyc
**/*.log
**/*.sqlite*
